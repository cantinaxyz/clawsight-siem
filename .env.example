DATABASE_URL="postgresql://clawsight:clawsight@127.0.0.1:5432/clawsight?schema=public"
SIEM_PORT=3000
# Legacy shared token (backward compatibility). Prefer separate ingest/admin tokens below.
SIEM_API_TOKEN=
# Agent/plugin ingest token (used by /api/telemetry/ingest and /v1/guardrails/decide).
SIEM_INGEST_TOKEN=
# Operator/admin token (used by safety/configuration control-plane APIs).
SIEM_ADMIN_TOKEN=
# Optional tenant token mapping for server-side project scoping on read APIs.
# Format: projectA:tokenA,projectB:tokenB
SIEM_PROJECT_TOKENS=

# Optional baseline guardrail config for /v1/guardrails/decide
# Legacy shared token alias (backward compatibility)
CLAWSIGHT_API_TOKEN=
CLAWSIGHT_TOOL_DENYLIST=rm,format,system,admin
CLAWSIGHT_TOOL_BLOCK_PATTERNS=rm -rf,python -c,base64 -d,nc ,ssh ,curl http://,wget http://
CLAWSIGHT_MESSAGE_BLOCK_PHRASES=blockme,ignore previous instructions

# Optional integrations
OPENAI_API_KEY=
DISCORD_API=
