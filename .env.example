# Local development DSN (pnpm workflow). Use a strong password.
DATABASE_URL="postgresql://clawsight:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/clawsight?schema=public"
# Docker Compose database settings (required for compose startup).
POSTGRES_DB=clawsight
POSTGRES_USER=clawsight
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SIEM_PORT=3000
# Legacy shared token (backward compatibility). Prefer separate ingest/admin tokens below.
# If unset, protected APIs fail closed (401) until explicit ingest/admin tokens are configured.
SIEM_API_TOKEN=
# Agent/plugin ingest token (used by /api/telemetry/ingest and /v1/guardrails/decide).
SIEM_INGEST_TOKEN=
# Operator/admin token (used by safety/configuration control-plane APIs).
SIEM_ADMIN_TOKEN=
# Optional tenant token mapping for server-side project scoping on read APIs.
# Format: projectA:tokenA,projectB:tokenB
SIEM_PROJECT_TOKENS=
# DNS enrichment mode for domain->IP resolution during ingest.
# apex (default, safer): resolve registrable domain only (e.g. attacker.com)
# full: resolve full observed hostname (e.g. secret.attacker.com)
SIEM_DNS_ENRICHMENT_MODE=apex
# Optional ingest timestamp skew bounds (milliseconds) for client-provided event ts.
# Defaults: past=86400000 (24h), future=300000 (5m).
SIEM_EVENT_TS_MAX_PAST_SKEW_MS=86400000
SIEM_EVENT_TS_MAX_FUTURE_SKEW_MS=300000

# Optional baseline guardrail config for /v1/guardrails/decide
# Legacy shared token alias (backward compatibility)
CLAWSIGHT_API_TOKEN=
CLAWSIGHT_TOOL_DENYLIST=rm,format,system,admin
CLAWSIGHT_TOOL_BLOCK_PATTERNS=rm -rf,python -c,base64 -d,nc ,ssh ,curl http://,wget http://
CLAWSIGHT_MESSAGE_BLOCK_PHRASES=blockme,ignore previous instructions

# Optional integrations
OPENAI_API_KEY=
DISCORD_API=
